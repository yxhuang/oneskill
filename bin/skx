#!/usr/bin/env python3
"""skx v1: audit and reconcile skills shared by Claude, Codex and Kimi."""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import sys
import tempfile
import unicodedata
from collections import Counter
from datetime import datetime
from pathlib import Path
from typing import Any


CLIENTS = ("claude", "codex", "kimi")
CLIENT_DIRS = {
    "claude": (".claude", "skills"),
    "codex": (".codex", "skills"),
    "kimi": (".kimi-code", "skills"),
}
SOURCES = {"self", "vendor", "external", "plugin"}
MANIFEST_VERSION = 1
PENDING_REVIEW = "待人工确认是否为有意的单端专属"


class SkxError(Exception):
    pass


def config() -> dict[str, Path]:
    home = Path(os.environ.get("SKX_HOME", str(Path.home()))).expanduser().absolute()
    agent_env = Path(
        os.environ.get("SKX_AGENT_ENV", "/home/you/skill-library")
    ).expanduser().absolute()
    default_manifest = Path(__file__).resolve().parent.parent / "skills.json"
    manifest = Path(os.environ.get("SKX_MANIFEST", str(default_manifest))).expanduser().absolute()
    result = {"home": home, "agent_env": agent_env, "manifest": manifest}
    for client, parts in CLIENT_DIRS.items():
        result[client] = home.joinpath(*parts)
    return result


def path_exists(path: Path) -> bool:
    return os.path.lexists(path)


def normalized(path: Path) -> Path:
    return Path(os.path.abspath(os.path.normpath(str(path)))).resolve(strict=False)


def link_target(path: Path) -> Path:
    raw = Path(os.readlink(path))
    if not raw.is_absolute():
        raw = path.parent / raw
    return normalized(raw)


def within(path: Path, parent: Path) -> bool:
    try:
        normalized(path).relative_to(normalized(parent))
        return True
    except ValueError:
        return False


def scope_clients(scope: Any) -> tuple[str, ...]:
    if scope == "shared":
        return CLIENTS
    if not isinstance(scope, list) or not scope:
        raise SkxError("scope 必须是 'shared' 或非空端名数组")
    invalid = [item for item in scope if item not in CLIENTS]
    if invalid:
        raise SkxError(f"scope 含无效端名：{', '.join(map(str, invalid))}")
    return tuple(client for client in CLIENTS if client in scope)


def scope_label(scope: Any) -> str:
    if scope == "shared":
        return "shared"
    if len(scope) == 1:
        return f"{scope[0]}-only"
    return ",".join(scope)


def validate_entry(entry: Any) -> dict[str, Any]:
    if not isinstance(entry, dict):
        raise SkxError("manifest 的 skills 每一项必须是对象")
    required = ("name", "source", "body", "scope")
    missing = [key for key in required if key not in entry]
    if missing:
        raise SkxError(f"manifest 条目缺字段：{', '.join(missing)}")
    name = entry["name"]
    if not isinstance(name, str) or not name or "/" in name or name in {".", ".."}:
        raise SkxError(f"无效 skill 名：{name!r}")
    if entry["source"] not in SOURCES:
        raise SkxError(f"{name} 的 source 无效：{entry['source']!r}")
    if not isinstance(entry["body"], str) or not entry["body"]:
        raise SkxError(f"{name} 的 body 必须是路径字符串")
    scope_clients(entry["scope"])
    if entry["source"] == "plugin" and scope_clients(entry["scope"]) != ("claude",):
        raise SkxError(f"plugin {name} 必须是 claude 单端作用域")
    return dict(entry)


def read_manifest(path: Path, allow_missing: bool = False) -> dict[str, Any]:
    if not path.exists():
        if allow_missing:
            return {"version": MANIFEST_VERSION, "skills": []}
        raise SkxError(f"manifest 不存在：{path}；请先运行 skx scan --write")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SkxError(f"无法读取 manifest {path}：{exc}") from exc
    if not isinstance(data, dict) or data.get("version") != MANIFEST_VERSION:
        raise SkxError(f"manifest version 必须是 {MANIFEST_VERSION}")
    if not isinstance(data.get("skills"), list):
        raise SkxError("manifest 缺少 skills 数组")
    entries = [validate_entry(item) for item in data["skills"]]
    names = [item["name"] for item in entries]
    duplicates = sorted(name for name, count in Counter(names).items() if count > 1)
    if duplicates:
        raise SkxError(f"manifest skill 重名：{', '.join(duplicates)}")
    return {"version": MANIFEST_VERSION, "skills": entries}


def write_manifest(path: Path, data: dict[str, Any]) -> None:
    entries = [validate_entry(item) for item in data["skills"]]
    entries.sort(key=lambda item: item["name"].casefold())
    output = {"version": MANIFEST_VERSION, "skills": entries}
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(output, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def infer_source(body: Path, cfg: dict[str, Path]) -> str:
    if within(body, cfg["agent_env"] / "vendor"):
        return "vendor"
    if within(body, cfg["agent_env"]):
        return "self"
    if within(body, cfg["home"] / ".agents" / "skills"):
        return "external"
    if within(body, cfg["home"] / ".claude" / "plugins"):
        return "plugin"
    return "external"


def visible_entries(directory: Path) -> dict[str, Path]:
    if not directory.is_dir():
        return {}
    try:
        return {
            item.name: item
            for item in directory.iterdir()
            if not item.name.startswith(".")
        }
    except OSError as exc:
        raise SkxError(f"无法扫描 {directory}：{exc}") from exc


def scan_plugins(cfg: dict[str, Path], occupied: set[str]) -> list[dict[str, Any]]:
    registry = cfg["home"] / ".claude" / "plugins" / "installed_plugins.json"
    if not registry.is_file():
        return []
    try:
        data = json.loads(registry.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    found: list[dict[str, Any]] = []
    plugins = data.get("plugins", {})
    if not isinstance(plugins, dict):
        return found
    for plugin_id, installs in sorted(plugins.items()):
        if not isinstance(installs, list) or not installs:
            continue
        active = installs[-1]
        install_path = active.get("installPath") if isinstance(active, dict) else None
        if not isinstance(install_path, str) or not install_path:
            continue
        base_name = plugin_id.split("@", 1)[0]
        name = base_name if base_name not in occupied else f"plugin:{base_name}"
        suffix = 2
        while name in occupied:
            name = f"plugin:{base_name}:{suffix}"
            suffix += 1
        occupied.add(name)
        found.append(
            {
                "name": name,
                "source": "plugin",
                "body": str(Path(install_path).expanduser().absolute()),
                "scope": ["claude"],
                "plugin_id": plugin_id,
            }
        )
    return found


def scan_environment(cfg: dict[str, Path]) -> dict[str, Any]:
    per_client = {client: visible_entries(cfg[client]) for client in CLIENTS}
    names = sorted(set().union(*(set(items) for items in per_client.values())))
    skills: list[dict[str, Any]] = []
    for name in names:
        present = [client for client in CLIENTS if name in per_client[client]]
        targets: list[Path] = []
        for client in present:
            path = per_client[client][name]
            if path.is_symlink():
                targets.append(link_target(path))
        if targets:
            body_text, _ = Counter(str(item) for item in targets).most_common(1)[0]
            body = Path(body_text)
        else:
            body = per_client[present[0]][name].absolute()
        scope: Any = "shared" if len(present) == len(CLIENTS) else present
        entry: dict[str, Any] = {
            "name": name,
            "source": infer_source(body, cfg),
            "body": str(body),
            "scope": scope,
        }
        if len(present) == 1:
            entry["review"] = PENDING_REVIEW
        skills.append(entry)
    occupied = {item["name"] for item in skills}
    skills.extend(scan_plugins(cfg, occupied))
    skills.sort(key=lambda item: item["name"].casefold())
    return {"version": MANIFEST_VERSION, "skills": skills}


def inspect_path(path: Path, body: Path, expected: bool) -> dict[str, Any]:
    base: dict[str, Any] = {"path": str(path), "expected": expected}
    if not path_exists(path):
        base.update(state="missing" if expected else "not_applicable", detail="缺失" if expected else "不适用")
        return base
    if not expected:
        kind = "软链" if path.is_symlink() else "真实目录" if path.is_dir() else "真实文件"
        base.update(state="extra", detail=f"多余{kind}")
        return base
    if path.is_symlink():
        target = link_target(path)
        base["target"] = str(target)
        if not path.exists():
            base.update(state="orphan_link", detail="断链/孤儿链")
        elif target != normalized(body):
            base.update(state="wrong_target", detail="软链目标不符")
        else:
            base.update(state="healthy", detail="软链健康")
        return base
    if path.is_dir():
        base.update(state="real_directory", detail="真实目录遮蔽")
    else:
        base.update(state="real_file", detail="真实文件遮蔽")
    return base


def build_inventory(cfg: dict[str, Path], manifest: dict[str, Any]) -> dict[str, Any]:
    declared = {item["name"]: item for item in manifest["skills"]}
    actual = {client: visible_entries(cfg[client]) for client in CLIENTS}
    actual_names = set().union(*(set(items) for items in actual.values()))
    rows: list[dict[str, Any]] = []
    for name in sorted(set(declared) | actual_names, key=str.casefold):
        if name in declared:
            entry = declared[name]
            source = entry["source"]
            body = Path(entry["body"]).expanduser().absolute()
            expected_clients = set(scope_clients(entry["scope"]))
            clients: dict[str, dict[str, Any]] = {}
            if source == "plugin":
                plugin_ok = body.exists()
                clients["claude"] = {
                    "path": str(body),
                    "expected": True,
                    "state": "plugin" if plugin_ok else "plugin_missing",
                    "detail": "插件已安装" if plugin_ok else "插件本体缺失",
                }
                for client in ("codex", "kimi"):
                    clients[client] = {
                        "path": str(cfg[client] / name),
                        "expected": False,
                        "state": "not_applicable",
                        "detail": "不适用",
                    }
            else:
                clients = {
                    client: inspect_path(cfg[client] / name, body, client in expected_clients)
                    for client in CLIENTS
                }
            rows.append(
                {
                    **entry,
                    "declared": True,
                    "clients": clients,
                }
            )
        else:
            present = [client for client in CLIENTS if name in actual[client]]
            sample = actual[present[0]][name]
            body = link_target(sample) if sample.is_symlink() else sample.absolute()
            rows.append(
                {
                    "name": name,
                    "source": infer_source(body, cfg),
                    "body": str(body),
                    "scope": present,
                    "declared": False,
                    "review": "未写入 manifest",
                    "clients": {
                        client: inspect_path(cfg[client] / name, body, False)
                        for client in CLIENTS
                    },
                }
            )
    good_states = {"healthy", "plugin", "not_applicable"}
    anomaly_cells = sum(
        status["state"] not in good_states
        for row in rows
        for status in row["clients"].values()
    )
    missing_cells = sum(
        status["state"] in {"missing", "plugin_missing"}
        for row in rows
        for status in row["clients"].values()
    )
    full_shared = sum(
        row["declared"]
        and row["source"] != "plugin"
        and row["scope"] == "shared"
        and all(row["clients"][client]["state"] == "healthy" for client in CLIENTS)
        for row in rows
    )
    return {
        "manifest": str(cfg["manifest"]),
        "skills": rows,
        "summary": {
            "skills": len(rows),
            "three_client_healthy": full_shared,
            "anomalies": anomaly_cells,
            "missing": missing_cells,
        },
    }


STATE_MARKS = {
    "healthy": "✓ 软链健康",
    "plugin": "✓ 插件",
    "not_applicable": "—",
    "missing": "○ 缺失",
    "plugin_missing": "! 插件缺失",
    "orphan_link": "! 断链",
    "wrong_target": "! 目标不符",
    "real_directory": "! 真实目录",
    "real_file": "! 真实文件",
    "extra": "! 多余",
}


def display_width(text: str) -> int:
    return sum(2 if unicodedata.east_asian_width(char) in "WFA" else 1 for char in text)


def pad(text: str, width: int) -> str:
    return text + " " * (width - display_width(text))


def render_table(inventory: dict[str, Any]) -> None:
    headers = ("skill", "来源", "作用域", "claude", "codex", "kimi")
    lines: list[tuple[str, ...]] = []
    for row in inventory["skills"]:
        lines.append(
            (
                row["name"],
                row["source"],
                scope_label(row["scope"]),
                *(STATE_MARKS[row["clients"][client]["state"]] for client in CLIENTS),
            )
        )
    widths = [display_width(header) for header in headers]
    for line in lines:
        widths = [max(width, display_width(cell)) for width, cell in zip(widths, line)]
    print("  ".join(pad(header, width) for header, width in zip(headers, widths)))
    print("  ".join("─" * width for width in widths))
    for line in lines:
        print("  ".join(pad(cell, width) for cell, width in zip(line, widths)))
    summary = inventory["summary"]
    print(
        f"\n共 {summary['skills']} 个 skill，{summary['three_client_healthy']} 个三端齐全，"
        f"{summary['anomalies']} 处异常（含 {summary['missing']} 处缺失）。"
    )


def shell_join(*parts: Path | str) -> str:
    return " ".join(shlex.quote(str(part)) for part in parts)


def repair_for(row: dict[str, Any], client: str, status: dict[str, Any]) -> str:
    path = Path(status["path"])
    body = Path(row["body"])
    state = status["state"]
    if state in {"missing"}:
        return shell_join("ln", "-s", body, path)
    if state in {"real_directory", "real_file", "wrong_target", "orphan_link"}:
        backup = Path(f"{path}.skx-backup")
        if not body.exists():
            return f"先恢复本体 {shlex.quote(str(body))}，再重建 {shlex.quote(str(path))}"
        return f"{shell_join('mv', path, backup)} && {shell_join('ln', '-s', body, path)}"
    if state == "extra":
        return shell_join("mv", path, Path(f"{path}.unmanaged-backup"))
    if state == "plugin_missing":
        plugin_id = row.get("plugin_id", row["name"])
        return f"用 Claude Code 重新安装插件 {shlex.quote(str(plugin_id))}"
    return "无需修复"


def diagnose(inventory: dict[str, Any]) -> dict[str, Any]:
    issues: list[dict[str, Any]] = []
    body_reported: set[str] = set()
    for row in inventory["skills"]:
        if row["declared"] and row.get("review"):
            issues.append(
                {
                    "type": "scope_review",
                    "skill": row["name"],
                    "client": None,
                    "path": inventory["manifest"],
                    "message": str(row["review"]),
                    "suggested_command": (
                        f"{shell_join('vi', inventory['manifest'])} && skx sync"
                    ),
                }
            )
        if row["declared"] and row["source"] != "plugin" and not Path(row["body"]).exists():
            if row["name"] not in body_reported:
                issues.append(
                    {
                        "type": "body_missing",
                        "skill": row["name"],
                        "client": None,
                        "path": row["body"],
                        "message": "manifest 声明的本体不存在",
                        "suggested_command": f"从版本库或备份恢复 {shlex.quote(row['body'])}",
                    }
                )
                body_reported.add(row["name"])
        for client in CLIENTS:
            status = row["clients"][client]
            state = status["state"]
            if state in {"healthy", "plugin", "not_applicable"}:
                continue
            messages = {
                "missing": "与 manifest 声明不符：缺少软链",
                "plugin_missing": "Claude 插件本体不存在",
                "orphan_link": "断链/孤儿链：软链指向不存在的本体",
                "wrong_target": "软链目标与 manifest 声明不符",
                "real_directory": "真实目录遮蔽了应有软链",
                "real_file": "真实文件遮蔽了应有软链",
                "extra": "与 manifest 声明不符：存在多余项",
            }
            issues.append(
                {
                    "type": state,
                    "skill": row["name"],
                    "client": client,
                    "path": status["path"],
                    "message": messages[state],
                    "suggested_command": repair_for(row, client, status),
                }
            )
    counts = Counter(issue["type"] for issue in issues)
    return {
        "manifest": inventory["manifest"],
        "issues": issues,
        "summary": {"issues": len(issues), "by_type": dict(sorted(counts.items()))},
    }


def render_doctor(report: dict[str, Any]) -> None:
    if not report["issues"]:
        print("未发现问题。")
        return
    for index, issue in enumerate(report["issues"], 1):
        endpoint = f" [{issue['client']}]" if issue["client"] else ""
        print(f"{index}. {issue['skill']}{endpoint}：{issue['message']}")
        print(f"   路径：{issue['path']}")
        print(f"   建议：{issue['suggested_command']}")
    print(f"\n共发现 {report['summary']['issues']} 个问题；doctor 未做任何修改。")


def parse_scope(value: str, origin: str) -> Any:
    if value == "shared":
        return "shared"
    requested = [item.strip() for item in value.split(",") if item.strip()]
    invalid = [item for item in requested if item not in CLIENTS]
    if invalid:
        raise SkxError(f"--scope 含无效端名：{', '.join(invalid)}")
    if origin not in requested:
        raise SkxError(f"--scope 必须包含发起端 {origin}")
    return [client for client in CLIENTS if client in requested]


def unique_backup(path: Path) -> Path:
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    candidate = Path(f"{path}.skx-backup-{stamp}")
    number = 2
    while path_exists(candidate):
        candidate = Path(f"{path}.skx-backup-{stamp}-{number}")
        number += 1
    return candidate


def confirm(description: str, assume_yes: bool, dry_run: bool = False) -> bool:
    print(f"将执行：{description}")
    if dry_run:
        return True
    if assume_yes:
        print("  --yes：已确认")
        return True
    try:
        answer = input("确认执行？[y/N] ").strip().lower()
    except EOFError:
        answer = ""
    return answer in {"y", "yes"}


def rollback_adopt(
    created: list[Path], backups: list[tuple[Path, Path]], moved: tuple[Path, Path] | None
) -> None:
    for path in reversed(created):
        if path.is_symlink():
            path.unlink()
    for original, backup in reversed(backups):
        if path_exists(original):
            if original.is_symlink():
                original.unlink()
            else:
                continue
        if path_exists(backup):
            os.replace(backup, original)
    if moved:
        source, target = moved
        if path_exists(target) and not path_exists(source):
            shutil.move(str(target), str(source))


def command_adopt(args: argparse.Namespace, cfg: dict[str, Path]) -> int:
    source_path = Path(args.path).expanduser().absolute()
    if source_path.is_symlink() or not source_path.is_dir():
        raise SkxError("adopt 只收编三端 skills 目录下现有的真实目录")
    origin = next(
        (client for client in CLIENTS if source_path.parent == cfg[client].absolute()), None
    )
    if origin is None:
        expected = "、".join(str(cfg[client]) for client in CLIENTS)
        raise SkxError(f"路径必须直接位于三端 skills 目录之一：{expected}")
    name = source_path.name
    manifest = read_manifest(cfg["manifest"], allow_missing=True)
    if any(item["name"] == name for item in manifest["skills"]):
        raise SkxError(f"manifest 已存在 {name}；请用 sync 对账")
    scope = parse_scope(args.scope, origin)
    selected = scope_clients(scope)
    target = (
        cfg["agent_env"] / "vendor" / name
        if args.vendor
        else cfg["agent_env"] / origin / "skills" / name
    )
    if path_exists(target):
        raise SkxError(f"目标本体已存在，拒绝覆盖：{target}")

    replacements: list[tuple[Path, Path]] = []
    for client in selected:
        destination = cfg[client] / name
        if destination == source_path or not path_exists(destination):
            continue
        if destination.is_symlink() and link_target(destination) == normalized(target):
            continue
        replacements.append((destination, unique_backup(destination)))

    confirmations = [
        f"移动本体 {source_path} → {target}",
        f"在原位置创建软链 {source_path} → {target}",
    ]
    for path, backup in replacements:
        confirmations.append(f"移动冲突项 {path} → {backup}")
        confirmations.append(f"在腾空的位置创建软链 {path} → {target}")
    print(f"收编计划：{name}（{origin} → {scope_label(scope)}，来源 {'vendor' if args.vendor else 'self'}）")
    for description in confirmations:
        if not confirm(description, args.yes, args.dry_run):
            print("已拒绝，未执行任何改动。")
            return 1
    for client in selected:
        destination = cfg[client] / name
        if destination == source_path or path_exists(destination):
            continue
        print(f"将执行：创建软链 {destination} → {target}")
    print(f"将执行：更新 manifest {cfg['manifest']}")
    if args.dry_run:
        print("dry-run 完成：未做任何修改。")
        return 0

    created: list[Path] = []
    backups_done: list[tuple[Path, Path]] = []
    moved: tuple[Path, Path] | None = None
    try:
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(source_path), str(target))
        moved = (source_path, target)
        source_path.symlink_to(target, target_is_directory=True)
        created.append(source_path)
        for destination, backup in replacements:
            destination.parent.mkdir(parents=True, exist_ok=True)
            os.replace(destination, backup)
            backups_done.append((destination, backup))
            destination.symlink_to(target, target_is_directory=True)
            created.append(destination)
        for client in selected:
            destination = cfg[client] / name
            if path_exists(destination):
                continue
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.symlink_to(target, target_is_directory=True)
            created.append(destination)
        entry: dict[str, Any] = {
            "name": name,
            "source": "vendor" if args.vendor else "self",
            "body": str(target),
            "scope": scope,
        }
        manifest["skills"].append(entry)
        write_manifest(cfg["manifest"], manifest)
    except Exception as exc:
        rollback_adopt(created, backups_done, moved)
        raise SkxError(f"收编失败，已尽力回滚：{exc}") from exc
    print(f"收编完成：{name}")
    return 0


def command_sync(args: argparse.Namespace, cfg: dict[str, Path]) -> int:
    manifest = read_manifest(cfg["manifest"])
    inventory = build_inventory(cfg, manifest)
    actions: list[dict[str, Any]] = []
    unresolved: list[str] = []
    for row in inventory["skills"]:
        if not row["declared"]:
            actual_clients = [
                client for client in CLIENTS if row["clients"][client]["state"] == "extra"
            ]
            unresolved.append(f"{row['name']}：manifest 外多余项（{','.join(actual_clients)}）")
            continue
        if row["source"] == "plugin":
            if row["clients"]["claude"]["state"] == "plugin_missing":
                unresolved.append(f"{row['name']}：插件本体缺失，需由 Claude 插件系统重装")
            continue
        body = Path(row["body"])
        for client in CLIENTS:
            if row["clients"][client]["state"] == "extra":
                unresolved.append(
                    f"{row['name']}：{client} 存在作用域外多余项 {row['clients'][client]['path']}"
                )
        if not body.exists():
            unresolved.append(f"{row['name']}：本体不存在 {body}")
            continue
        for client in scope_clients(row["scope"]):
            status = row["clients"][client]
            state = status["state"]
            destination = Path(status["path"])
            if state == "healthy":
                continue
            if state == "missing":
                actions.append({"kind": "create", "path": destination, "body": body})
            elif state in {"real_directory", "real_file", "wrong_target", "orphan_link"}:
                actions.append(
                    {
                        "kind": "replace",
                        "path": destination,
                        "body": body,
                        "backup": unique_backup(destination),
                        "state": state,
                    }
                )

    for action in actions:
        if action["kind"] == "create":
            print(f"将执行：创建软链 {action['path']} → {action['body']}")
        else:
            description = (
                f"移动偏差项 {action['path']} → {action['backup']}，"
                f"再创建软链 → {action['body']}"
            )
            if not confirm(description, args.yes, args.dry_run):
                print("已拒绝该项，继续检查其余项目。")
                action["skip"] = True
    if args.dry_run:
        planned = sum(not action.get("skip") for action in actions)
        print(f"dry-run 完成：计划改动 {planned} 处，实际零改动。")
        for item in unresolved:
            print(f"偏差：{item}")
        return 0

    changed = 0
    for action in actions:
        if action.get("skip"):
            unresolved.append(f"{action['path']}：用户拒绝替换")
            continue
        destination = action["path"]
        try:
            destination.parent.mkdir(parents=True, exist_ok=True)
            if action["kind"] == "replace":
                os.replace(destination, action["backup"])
            destination.symlink_to(action["body"], target_is_directory=True)
            changed += 1
        except OSError as exc:
            unresolved.append(f"{destination}：执行失败：{exc}")
            if action["kind"] == "replace" and path_exists(action["backup"]):
                if destination.is_symlink():
                    destination.unlink()
                if not path_exists(destination):
                    os.replace(action["backup"], destination)
    if changed == 0:
        print("同步完成：零改动。")
    else:
        print(f"同步完成：改动 {changed} 处。")
    for item in unresolved:
        print(f"偏差：{item}")
    return 1 if unresolved else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="skx", description="三端 LLM CLI skill 覆盖审计与同步工具")
    parser.add_argument("--version", action="version", version="skx 1.0.0")
    subparsers = parser.add_subparsers(dest="command", required=True)

    list_parser = subparsers.add_parser("list", help="显示 skill 覆盖矩阵")
    list_parser.add_argument("--json", action="store_true", help="输出机器可读 JSON")

    doctor_parser = subparsers.add_parser("doctor", help="只读诊断偏差")
    doctor_parser.add_argument("--json", action="store_true", help="输出机器可读 JSON")

    scan_parser = subparsers.add_parser("scan", help="扫描当前环境生成 manifest 草稿")
    scan_parser.add_argument("--write", action="store_true", help="写入 manifest；否则打印到 stdout")

    adopt_parser = subparsers.add_parser("adopt", help="把端内真实目录收编到共享库")
    adopt_parser.add_argument("path", help="要收编的真实 skill 目录")
    adopt_parser.add_argument("--vendor", action="store_true", help="归入 agent-env/vendor")
    adopt_parser.add_argument(
        "--scope",
        default="shared",
        help="shared（默认）或逗号分隔端名，如 codex,kimi",
    )
    adopt_parser.add_argument("--dry-run", action="store_true", help="只打印计划")
    adopt_parser.add_argument("--yes", action="store_true", help="自动确认（主要供测试/自动化）")

    sync_parser = subparsers.add_parser("sync", help="按 manifest 幂等补链和对账")
    sync_parser.add_argument("--dry-run", action="store_true", help="只打印计划")
    sync_parser.add_argument("--yes", action="store_true", help="自动确认偏差项替换")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    cfg = config()
    try:
        if args.command == "scan":
            draft = scan_environment(cfg)
            if args.write:
                write_manifest(cfg["manifest"], draft)
                print(f"已写入 manifest 草稿：{cfg['manifest']}（{len(draft['skills'])} 个条目）")
            else:
                json.dump(draft, sys.stdout, ensure_ascii=False, indent=2)
                print()
            return 0
        if args.command == "list":
            inventory = build_inventory(cfg, read_manifest(cfg["manifest"]))
            if args.json:
                json.dump(inventory, sys.stdout, ensure_ascii=False, indent=2)
                print()
            else:
                render_table(inventory)
            return 0
        if args.command == "doctor":
            report = diagnose(build_inventory(cfg, read_manifest(cfg["manifest"])))
            if args.json:
                json.dump(report, sys.stdout, ensure_ascii=False, indent=2)
                print()
            else:
                render_doctor(report)
            return 1 if report["issues"] else 0
        if args.command == "adopt":
            return command_adopt(args, cfg)
        if args.command == "sync":
            return command_sync(args, cfg)
        parser.error("未知命令")
    except SkxError as exc:
        if getattr(args, "json", False):
            json.dump({"error": str(exc)}, sys.stdout, ensure_ascii=False)
            print()
        else:
            print(f"错误：{exc}", file=sys.stderr)
        return 2
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
