#!/usr/bin/env python3
"""oneskill: audit and manage skills shared by Claude, Codex and Kimi."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import sys
import tarfile
import tempfile
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from collections import Counter
from contextlib import contextmanager
from datetime import datetime
from pathlib import Path
from typing import Any, Iterator


__version__ = "0.3.0"

CLIENTS = {
    "claude": (".claude", "skills"),
    "codex": (".codex", "skills"),
    "kimi": (".kimi-code", "skills"),
}
SOURCES = {"self", "vendor", "external", "plugin", "remote"}
MANIFEST_VERSION = 2
SUPPORTED_MANIFEST_VERSIONS = {1, MANIFEST_VERSION}
SAFE_SKILL_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
GITHUB_SOURCE = re.compile(
    r"^gh:(?P<owner>[A-Za-z0-9_.-]+)/(?P<repo>[A-Za-z0-9_.-]+)"
    r"(?P<rest>(?:/[^@]+)?)(?:@(?P<ref>.+))?$"
)
USER_AGENT = f"oneskill/{__version__} (+https://github.com/yxhuang/oneskill)"
PENDING_REVIEW = "needs review: single-client skill, confirm if intentional"
UNMANAGED_REVIEW = "not in the shared library yet; run `osk adopt` to bring it under management"
CONFIG_DIR_PARTS = (".config", "oneskill")
DEFAULT_LIBRARY_PARTS = (".oneskill", "library")
AGENTS_LIBRARY_PARTS = (".agents", "skills")
NETWORK_TIMEOUT = 15


class OneskillError(Exception):
    pass


def config_file_path(home: Path) -> Path:
    return home.joinpath(*CONFIG_DIR_PARTS, "config.json")


def read_config_file(home: Path) -> dict[str, Any]:
    path = config_file_path(home)
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise OneskillError(f"cannot read config file {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise OneskillError(f"config file {path} must contain a JSON object")
    return data


def config_string(file_cfg: dict[str, Any], key: str, home: Path) -> str | None:
    value = file_cfg.get(key)
    if value is None:
        return None
    if not isinstance(value, str) or not value:
        raise OneskillError(f"config file {config_file_path(home)}: {key!r} must be a non-empty path string")
    return value


def config() -> dict[str, Path]:
    home = Path(os.environ.get("ONESKILL_HOME", str(Path.home()))).expanduser().absolute()
    file_cfg = read_config_file(home)
    library = os.environ.get("ONESKILL_LIBRARY") or config_string(file_cfg, "library", home)
    if not library:
        library = str(home.joinpath(*DEFAULT_LIBRARY_PARTS))
    manifest = os.environ.get("ONESKILL_MANIFEST") or config_string(file_cfg, "manifest", home)
    if not manifest:
        manifest = str(home.joinpath(*CONFIG_DIR_PARTS, "skills.json"))
    result = {
        "home": home,
        "library": Path(library).expanduser().absolute(),
        "manifest": Path(manifest).expanduser().absolute(),
    }
    for client, parts in CLIENTS.items():
        result[client] = home.joinpath(*parts)
    return result


def require_library(cfg: dict[str, Path]) -> None:
    library = cfg["library"]
    if not library.is_dir():
        raise OneskillError(
            f"skill library not found: {library}\n"
            "run `osk init` to configure oneskill (or set ONESKILL_LIBRARY to an existing directory)"
        )


def path_exists(path: Path) -> bool:
    return os.path.lexists(path)


def normalized(path: Path) -> Path:
    return Path(os.path.abspath(os.path.normpath(str(path)))).resolve(strict=False)


def link_target(path: Path) -> Path:
    raw = Path(os.readlink(path))
    if not raw.is_absolute():
        raw = path.parent / raw
    return normalized(raw)


def same_body(left: Any, right: Any) -> bool:
    """Whether two manifest body paths name the same directory.

    A plain string compare is wrong wherever a path component is a symlink:
    on macOS /tmp/x and /private/tmp/x are one directory but two strings, and
    scan writes the resolved form while a hand-written manifest may not.
    """
    if left is None or right is None:
        return left is None and right is None
    return normalized(Path(left)) == normalized(Path(right))


def within(path: Path, parent: Path) -> bool:
    try:
        normalized(path).relative_to(normalized(parent))
        return True
    except ValueError:
        return False


def scope_clients(scope: Any) -> tuple[str, ...]:
    if scope == "shared":
        return tuple(CLIENTS)
    if not isinstance(scope, list) or not scope:
        raise OneskillError("scope must be 'shared' or a non-empty list of client names")
    invalid = [item for item in scope if item not in CLIENTS]
    if invalid:
        raise OneskillError(f"scope contains unknown client name(s): {', '.join(map(str, invalid))}")
    return tuple(client for client in CLIENTS if client in scope)


def scope_label(scope: Any) -> str:
    if scope == "shared":
        return "shared"
    if len(scope) == 1:
        return f"{scope[0]}-only"
    return ",".join(scope)


def validate_entry(entry: Any) -> dict[str, Any]:
    if not isinstance(entry, dict):
        raise OneskillError("each manifest skills entry must be an object")
    required = ("name", "source", "body", "scope")
    missing = [key for key in required if key not in entry]
    if missing:
        raise OneskillError(f"manifest entry is missing field(s): {', '.join(missing)}")
    name = entry["name"]
    if not isinstance(name, str) or not name or "/" in name or name in {".", ".."}:
        raise OneskillError(f"invalid skill name: {name!r}")
    if entry["source"] not in SOURCES:
        raise OneskillError(f"{name} has an invalid source: {entry['source']!r}")
    body = entry["body"]
    if body is not None and (not isinstance(body, str) or not body):
        raise OneskillError(f"{name}: body must be a path string or null")
    if entry["source"] == "plugin" and body is None:
        raise OneskillError(f"plugin {name} must declare a body path")
    scope_clients(entry["scope"])
    if entry["source"] == "plugin" and scope_clients(entry["scope"]) != ("claude",):
        raise OneskillError(f"plugin {name} must be scoped to claude only")
    description = entry.get("description")
    if description is not None and (not isinstance(description, str) or not description.strip()):
        raise OneskillError(f"{name}: description must be a non-empty string")
    provenance = entry.get("provenance")
    if provenance is not None:
        if not isinstance(provenance, dict):
            raise OneskillError(f"{name}: provenance must be an object")
        for key in ("source_url", "ref", "installed_at"):
            value = provenance.get(key)
            if not isinstance(value, str) or not value:
                raise OneskillError(f"{name}: provenance.{key} must be a non-empty string")
    single_ok = entry.get("single_client_ok")
    if single_ok is not None and not isinstance(single_ok, bool):
        raise OneskillError(f"{name}: single_client_ok must be true or false")
    return dict(entry)


def read_manifest(path: Path, allow_missing: bool = False) -> dict[str, Any]:
    if not path.exists():
        if allow_missing:
            return {"version": MANIFEST_VERSION, "skills": []}
        raise OneskillError(f"manifest not found: {path}; run `osk scan --write` first")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise OneskillError(f"cannot read manifest {path}: {exc}") from exc
    if not isinstance(data, dict) or data.get("version") not in SUPPORTED_MANIFEST_VERSIONS:
        versions = ", ".join(str(item) for item in sorted(SUPPORTED_MANIFEST_VERSIONS))
        raise OneskillError(f"manifest version must be one of: {versions}")
    if not isinstance(data.get("skills"), list):
        raise OneskillError("manifest is missing the skills array")
    entries = [validate_entry(item) for item in data["skills"]]
    names = [item["name"] for item in entries]
    duplicates = sorted(name for name, count in Counter(names).items() if count > 1)
    if duplicates:
        raise OneskillError(f"duplicate skill name(s) in manifest: {', '.join(duplicates)}")
    return {"version": MANIFEST_VERSION, "skills": entries}


def write_manifest(path: Path, data: dict[str, Any]) -> None:
    entries = [validate_entry(item) for item in data["skills"]]
    entries.sort(key=lambda item: item["name"].casefold())
    output = {"version": MANIFEST_VERSION, "skills": entries}
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(output, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def update_cache_path(cfg: dict[str, Path]) -> Path:
    return cfg["manifest"].parent / "update-cache.json"


def read_update_cache(cfg: dict[str, Path]) -> dict[str, Any]:
    path = update_cache_path(cfg)
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(data, dict):
        return {}
    return data


def apply_update_cache(inventory: dict[str, Any], cache: dict[str, Any]) -> None:
    cached = cache.get("skills")
    if not isinstance(cached, dict):
        cached = {}
    for row in inventory["skills"]:
        if row.get("source") != "remote":
            continue
        entry = cached.get(row["name"])
        row["update_available"] = bool(isinstance(entry, dict) and entry.get("update_available"))
    if isinstance(cache.get("checked_at"), str):
        inventory["update_checked_at"] = cache["checked_at"]


def infer_source(body: Path, cfg: dict[str, Path]) -> str:
    if within(body, cfg["library"] / "remote"):
        return "remote"
    if within(body, cfg["library"] / "vendor"):
        return "vendor"
    if within(body, cfg["library"]):
        return "self"
    if within(body, cfg["home"] / ".agents" / "skills"):
        return "external"
    if within(body, cfg["home"] / ".claude" / "plugins"):
        return "plugin"
    return "external"


def installed_at_now() -> str:
    return datetime.now().astimezone().isoformat(timespec="seconds")


def parse_frontmatter_scalar(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] == '"':
        try:
            decoded = json.loads(value)
        except json.JSONDecodeError:
            decoded = value[1:-1]
        return decoded if isinstance(decoded, str) else str(decoded)
    if len(value) >= 2 and value[0] == value[-1] == "'":
        return value[1:-1].replace("''", "'")
    return value


def read_skill_metadata(skill_dir: Path) -> dict[str, str]:
    skill_file = skill_dir / "SKILL.md"
    if not skill_file.is_file():
        raise OneskillError(f"skill directory must contain SKILL.md: {skill_dir}")
    try:
        text = skill_file.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        raise OneskillError(f"cannot read {skill_file}: {exc}") from exc
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        raise OneskillError(f"{skill_file}: YAML frontmatter is required")
    try:
        end = next(index for index in range(1, len(lines)) if lines[index].strip() == "---")
    except StopIteration as exc:
        raise OneskillError(f"{skill_file}: YAML frontmatter is not closed") from exc
    metadata: dict[str, str] = {}
    index = 1
    while index < end:
        line = lines[index]
        match = re.match(r"^([A-Za-z_][A-Za-z0-9_-]*):(?:\s*(.*))?$", line)
        if not match:
            index += 1
            continue
        key, raw = match.group(1), (match.group(2) or "")
        if raw.strip() in {"|", "|-", "|+", ">", ">-", ">+"}:
            folded = raw.strip().startswith(">")
            block: list[str] = []
            index += 1
            while index < end and (not lines[index].strip() or lines[index][0].isspace()):
                block.append(lines[index].lstrip())
                index += 1
            metadata[key] = (" " if folded else "\n").join(block).strip()
            continue
        metadata[key] = parse_frontmatter_scalar(raw)
        index += 1
    for key in ("name", "description"):
        if not metadata.get(key, "").strip():
            raise OneskillError(f"{skill_file}: YAML frontmatter must contain non-empty {key}")
    return {"name": metadata["name"].strip(), "description": metadata["description"].strip()}


def validate_remote_skill_name(name: str) -> None:
    if not SAFE_SKILL_NAME.fullmatch(name):
        raise OneskillError(
            f"unsafe skill name {name!r}; use only letters, digits, dot, underscore, and hyphen"
        )


def parse_github_source(source: str) -> tuple[str, str, str | None, str | None]:
    match = GITHUB_SOURCE.fullmatch(source)
    if not match:
        raise OneskillError("GitHub source must look like gh:owner/repo[/subdir][@ref]")
    owner, repo = match.group("owner"), match.group("repo")
    rest = match.group("rest") or ""
    subdir = rest[1:] if rest.startswith("/") else None
    ref = match.group("ref")
    if subdir:
        parts = Path(subdir).parts
        if Path(subdir).is_absolute() or any(part in {"", ".", ".."} for part in parts):
            raise OneskillError(f"unsafe GitHub subdirectory: {subdir!r}")
    if ref is not None and not ref.strip():
        raise OneskillError("GitHub ref must not be empty")
    return owner, repo, subdir, ref


def download_url(url: str, destination: Path) -> None:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=30) as response, destination.open("wb") as output:
            shutil.copyfileobj(response, output)
    except (OSError, urllib.error.URLError) as exc:
        raise OneskillError(f"download failed for {url}: {exc}") from exc


def http_get_json(url: str) -> Any:
    headers = {"User-Agent": USER_AGENT, "Accept": "application/json"}
    if url.startswith("https://api.github.com/"):
        token = os.environ.get("GITHUB_TOKEN")
        if token:
            headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=NETWORK_TIMEOUT) as response:
            payload = response.read()
    except urllib.error.HTTPError as exc:
        remaining = exc.headers.get("X-RateLimit-Remaining") if exc.headers else None
        if exc.code == 403 and remaining == "0":
            when = ""
            reset = exc.headers.get("X-RateLimit-Reset")
            if reset and reset.isdigit():
                stamp = datetime.fromtimestamp(int(reset)).astimezone()
                when = f"; the limit resets at {stamp.strftime('%Y-%m-%d %H:%M:%S %Z').strip()}"
            raise OneskillError(
                "GitHub anonymous API rate limit exceeded (60 requests/hour)"
                f"{when}; set the GITHUB_TOKEN environment variable for a higher quota"
            ) from exc
        raise OneskillError(f"request failed for {url}: HTTP {exc.code} {exc.reason}") from exc
    except (OSError, urllib.error.URLError) as exc:
        raise OneskillError(f"request failed for {url}: {exc}") from exc
    try:
        return json.loads(payload.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise OneskillError(f"invalid JSON response from {url}: {exc}") from exc


def extract_safe_tar(archive: Path, destination: Path) -> Path:
    destination.mkdir(parents=True, exist_ok=True)
    try:
        handle = tarfile.open(archive, mode="r:*")
    except (OSError, tarfile.TarError) as exc:
        raise OneskillError(f"cannot open source archive {archive}: {exc}") from exc
    with handle:
        for member in handle.getmembers():
            member_path = Path(member.name)
            if member_path.is_absolute() or any(part == ".." for part in member_path.parts):
                raise OneskillError(f"unsafe path in source archive: {member.name}")
            target = destination / member_path
            if not within(target, destination):
                raise OneskillError(f"archive member escapes extraction directory: {member.name}")
            if member.isdir():
                target.mkdir(parents=True, exist_ok=True)
                continue
            if not member.isfile():
                raise OneskillError(f"unsupported link or special file in source archive: {member.name}")
            target.parent.mkdir(parents=True, exist_ok=True)
            source_file = handle.extractfile(member)
            if source_file is None:
                raise OneskillError(f"cannot read archive member: {member.name}")
            with source_file, target.open("wb") as output:
                shutil.copyfileobj(source_file, output)
            os.chmod(target, member.mode & 0o777)
    roots = [item for item in destination.iterdir() if item.name not in {"pax_global_header"}]
    if len(roots) != 1 or not roots[0].is_dir():
        raise OneskillError("source archive must contain exactly one top-level directory")
    return roots[0]


def archive_commit_ref(root: Path) -> str | None:
    match = re.search(r"-([0-9a-fA-F]{7,40})$", root.name)
    return match.group(1).lower()[:12] if match else None


@contextmanager
def materialize_skill_source(source: str) -> Iterator[dict[str, Any]]:
    """Resolve a directory, local tarball, or gh: source to a local skill directory."""
    if source.startswith("gh:"):
        owner, repo, subdir, requested_ref = parse_github_source(source)
        base = f"https://api.github.com/repos/{owner}/{repo}/tarball"
        if requested_ref:
            base += "/" + urllib.parse.quote(requested_ref, safe="")
        with tempfile.TemporaryDirectory(prefix="oneskill-source-") as temporary:
            temporary_path = Path(temporary)
            archive = temporary_path / "source.tar.gz"
            download_url(base, archive)
            root = extract_safe_tar(archive, temporary_path / "unpacked")
            commit_ref = archive_commit_ref(root)
            if commit_ref is None:
                raise OneskillError("GitHub archive did not expose a commit SHA in its top-level directory")
            skill_dir = root / subdir if subdir else root
            yield {"directory": skill_dir, "ref": commit_ref, "source_url": source}
        return

    local = Path(source).expanduser().absolute()
    if local.is_dir():
        yield {"directory": local, "ref": "local", "source_url": str(local)}
        return
    if local.is_file() and (local.name.endswith(".tar.gz") or local.suffix == ".tgz"):
        with tempfile.TemporaryDirectory(prefix="oneskill-source-") as temporary:
            root = extract_safe_tar(local, Path(temporary) / "unpacked")
            yield {
                "directory": root,
                "ref": archive_commit_ref(root) or "local",
                "source_url": str(local),
            }
        return
    raise OneskillError(f"source is neither a skill directory nor a supported gh: source: {source}")


def tree_snapshot(root: Path) -> dict[str, str]:
    snapshot: dict[str, str] = {}
    for path in sorted(root.rglob("*"), key=lambda item: str(item.relative_to(root))):
        relative = path.relative_to(root).as_posix()
        if path.is_symlink():
            snapshot[relative] = "link:" + os.readlink(path)
        elif path.is_dir():
            snapshot[relative + "/"] = "directory"
        elif path.is_file():
            digest = hashlib.sha256()
            with path.open("rb") as handle:
                for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                    digest.update(chunk)
            snapshot[relative] = "file:" + digest.hexdigest()
    return snapshot


def compare_skill_trees(old: Path, new: Path) -> dict[str, list[str]]:
    old_snapshot = tree_snapshot(old)
    new_snapshot = tree_snapshot(new)
    old_names, new_names = set(old_snapshot), set(new_snapshot)
    return {
        "added": sorted(new_names - old_names),
        "removed": sorted(old_names - new_names),
        "modified": sorted(
            name for name in old_names & new_names if old_snapshot[name] != new_snapshot[name]
        ),
    }


def visible_entries(directory: Path) -> dict[str, Path]:
    if not directory.is_dir():
        return {}
    try:
        return {
            item.name: item
            for item in directory.iterdir()
            if not item.name.startswith(".")
        }
    except OSError as exc:
        raise OneskillError(f"cannot scan {directory}: {exc}") from exc


def scan_plugins(cfg: dict[str, Path], occupied: set[str]) -> list[dict[str, Any]]:
    registry = cfg["home"] / ".claude" / "plugins" / "installed_plugins.json"
    if not registry.is_file():
        return []
    try:
        data = json.loads(registry.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    found: list[dict[str, Any]] = []
    plugins = data.get("plugins", {})
    if not isinstance(plugins, dict):
        return found
    for plugin_id, installs in sorted(plugins.items()):
        if not isinstance(installs, list) or not installs:
            continue
        active = installs[-1]
        install_path = active.get("installPath") if isinstance(active, dict) else None
        if not isinstance(install_path, str) or not install_path:
            continue
        base_name = plugin_id.split("@", 1)[0]
        name = base_name if base_name not in occupied else f"plugin:{base_name}"
        suffix = 2
        while name in occupied:
            name = f"plugin:{base_name}:{suffix}"
            suffix += 1
        occupied.add(name)
        found.append(
            {
                "name": name,
                "source": "plugin",
                "body": str(Path(install_path).expanduser().absolute()),
                "scope": ["claude"],
                "plugin_id": plugin_id,
            }
        )
    return found


def scan_environment(cfg: dict[str, Path]) -> dict[str, Any]:
    previous_remote: dict[str, dict[str, Any]] = {}
    previous_by_name: dict[str, dict[str, Any]] = {}
    if cfg["manifest"].is_file():
        try:
            previous = read_manifest(cfg["manifest"])
        except OneskillError:
            previous = {"skills": []}
        previous_remote = {
            item["name"]: item for item in previous["skills"] if item["source"] == "remote"
        }
        # single_client_ok records a human decision and is independent of source,
        # so index every previous entry by name rather than just the remote ones.
        previous_by_name = {item["name"]: item for item in previous["skills"]}
    per_client = {client: visible_entries(cfg[client]) for client in CLIENTS}
    names = sorted(set().union(*(set(items) for items in per_client.values())))
    skills: list[dict[str, Any]] = []
    for name in names:
        present = [client for client in CLIENTS if name in per_client[client]]
        targets: list[Path] = []
        for client in present:
            path = per_client[client][name]
            if path.is_symlink():
                targets.append(link_target(path))
        if targets:
            body_text, _ = Counter(str(item) for item in targets).most_common(1)[0]
            body: Path | None = Path(body_text)
        else:
            # no symlink points anywhere: the only copy is the real directory
            # itself, so there is no shared body yet. Leave body null rather
            # than pointing it at the client's own path (which would make
            # every later repair suggestion self-referential).
            body = None
        scope: Any = "shared" if len(present) == len(CLIENTS) else present
        sample = per_client[present[0]][name].absolute()
        entry: dict[str, Any] = {
            "name": name,
            "source": infer_source(body if body is not None else sample, cfg),
            "body": str(body) if body is not None else None,
            "scope": scope,
        }
        old_remote = previous_remote.get(name)
        if (
            entry["source"] == "remote"
            and old_remote is not None
            and same_body(old_remote.get("body"), entry["body"])
        ):
            for key in ("description", "provenance"):
                if key in old_remote:
                    entry[key] = old_remote[key]
        # Carry over a confirmed single-client decision. It was made about one
        # specific body, so a changed body voids it and review comes back.
        old_entry = previous_by_name.get(name)
        if (
            old_entry is not None
            and old_entry.get("single_client_ok") is True
            and same_body(old_entry.get("body"), entry["body"])
        ):
            entry["single_client_ok"] = True
        if body is None:
            entry["review"] = UNMANAGED_REVIEW
        elif len(present) == 1 and not entry.get("single_client_ok"):
            entry["review"] = PENDING_REVIEW
        skills.append(entry)
    occupied = {item["name"] for item in skills}
    skills.extend(scan_plugins(cfg, occupied))
    skills.sort(key=lambda item: item["name"].casefold())
    return {"version": MANIFEST_VERSION, "skills": skills}


def inspect_path(path: Path, body: Path, expected: bool) -> dict[str, Any]:
    base: dict[str, Any] = {"path": str(path), "expected": expected}
    if not path_exists(path):
        base.update(state="missing" if expected else "not_applicable", detail="missing" if expected else "not applicable")
        return base
    if not expected:
        kind = "symlink" if path.is_symlink() else "real directory" if path.is_dir() else "real file"
        base.update(state="extra", detail=f"extra {kind}")
        return base
    if path.is_symlink():
        target = link_target(path)
        base["target"] = str(target)
        if not path.exists():
            base.update(state="orphan_link", detail="broken symlink (orphan link)")
        elif target != normalized(body):
            base.update(state="wrong_target", detail="symlink target mismatch")
        else:
            base.update(state="healthy", detail="symlink healthy")
        return base
    if path.is_dir():
        if normalized(path) == normalized(body):
            # the inferred body is this directory itself: there is no shared
            # body elsewhere, so this is an unmanaged skill, not a shadow
            base.update(state="unmanaged", detail="not in the shared library yet")
        else:
            base.update(state="real_directory", detail="real directory shadows the link")
        return base
    if normalized(path) == normalized(body):
        base.update(state="unmanaged", detail="not in the shared library yet")
    else:
        base.update(state="real_file", detail="real file shadows the link")
    return base


def build_inventory(cfg: dict[str, Path], manifest: dict[str, Any]) -> dict[str, Any]:
    declared = {item["name"]: item for item in manifest["skills"]}
    actual = {client: visible_entries(cfg[client]) for client in CLIENTS}
    actual_names = set().union(*(set(items) for items in actual.values()))
    rows: list[dict[str, Any]] = []
    for name in sorted(set(declared) | actual_names, key=str.casefold):
        if name in declared:
            entry = declared[name]
            source = entry["source"]
            raw_body = entry["body"]
            body = Path(raw_body).expanduser().absolute() if raw_body is not None else None
            expected_clients = set(scope_clients(entry["scope"]))
            clients: dict[str, dict[str, Any]] = {}
            if source == "plugin":
                plugin_ok = body is not None and body.exists()
                clients["claude"] = {
                    "path": str(body),
                    "expected": True,
                    "state": "plugin" if plugin_ok else "plugin_missing",
                    "detail": "plugin installed" if plugin_ok else "plugin body missing",
                }
                for client in CLIENTS:
                    if client == "claude":
                        continue
                    clients[client] = {
                        "path": str(cfg[client] / name),
                        "expected": False,
                        "state": "not_applicable",
                        "detail": "not applicable",
                    }
            else:
                clients = {
                    client: inspect_path(
                        cfg[client] / name,
                        # with no declared body, compare each client path
                        # against itself so real directories read as unmanaged
                        body if body is not None else cfg[client] / name,
                        client in expected_clients,
                    )
                    for client in CLIENTS
                }
            rows.append(
                {
                    **entry,
                    "declared": True,
                    "clients": clients,
                }
            )
        else:
            present = [client for client in CLIENTS if name in actual[client]]
            sample = actual[present[0]][name]
            body = link_target(sample) if sample.is_symlink() else sample.absolute()
            rows.append(
                {
                    "name": name,
                    "source": infer_source(body, cfg),
                    "body": str(body),
                    "scope": present,
                    "declared": False,
                    "review": "not declared in manifest",
                    "clients": {
                        client: inspect_path(cfg[client] / name, body, False)
                        for client in CLIENTS
                    },
                }
            )
    good_states = {"healthy", "plugin", "not_applicable"}
    anomaly_cells = sum(
        status["state"] not in good_states
        for row in rows
        for status in row["clients"].values()
    )
    missing_cells = sum(
        status["state"] in {"missing", "plugin_missing"}
        for row in rows
        for status in row["clients"].values()
    )
    full_shared = sum(
        row["declared"]
        and row["source"] != "plugin"
        and row["scope"] == "shared"
        and all(row["clients"][client]["state"] == "healthy" for client in CLIENTS)
        for row in rows
    )
    return {
        "manifest": str(cfg["manifest"]),
        "skills": rows,
        "summary": {
            "skills": len(rows),
            "three_client_healthy": full_shared,
            "anomalies": anomaly_cells,
            "missing": missing_cells,
        },
    }


STATE_MARKS = {
    "healthy": "✓ linked",
    "plugin": "✓ plugin",
    "not_applicable": "—",
    "missing": "○ missing",
    "plugin_missing": "! plugin gone",
    "orphan_link": "! broken",
    "wrong_target": "! mismatch",
    "real_directory": "! real dir",
    "real_file": "! real file",
    "unmanaged": "○ unmanaged",
    "extra": "! extra",
}

GOOD_STATES = {"healthy", "plugin", "not_applicable"}


def display_width(text: str) -> int:
    # 只把 W/F（真正的宽字符，如 CJK）算作 2 列；A（歧义字符，如 — ○ ─）在英文终端按 1 列渲染
    return sum(2 if unicodedata.east_asian_width(char) in "WF" else 1 for char in text)


def pad(text: str, width: int) -> str:
    return text + " " * (width - display_width(text))


def table_cells(row: dict[str, Any]) -> tuple[str, ...]:
    provenance = row.get("provenance")
    ref = provenance.get("ref", "—") if isinstance(provenance, dict) else "—"
    if row.get("update_available"):
        ref = f"{ref} ↑"
    return (
        row["name"],
        row["source"],
        ref,
        scope_label(row["scope"]),
        *(STATE_MARKS[row["clients"][client]["state"]] for client in CLIENTS),
    )


def has_anomaly(row: dict[str, Any]) -> bool:
    return any(row["clients"][client]["state"] not in GOOD_STATES for client in CLIENTS)


def render_table(inventory: dict[str, Any]) -> None:
    headers = ("skill", "source", "ref", "scope", *CLIENTS)
    shared: list[dict[str, Any]] = []
    specific: list[dict[str, Any]] = []
    attention: list[dict[str, Any]] = []
    for row in inventory["skills"]:
        if row["scope"] == "shared" and all(
            row["clients"][client]["state"] == "healthy" for client in CLIENTS
        ):
            shared.append(row)
        elif has_anomaly(row):
            attention.append(row)
        else:
            specific.append(row)
    shared.sort(key=lambda row: row["name"].casefold())
    specific.sort(
        key=lambda row: (
            tuple(CLIENTS).index(scope_clients(row["scope"])[0])
            if row["scope"] != "shared"
            else len(CLIENTS),
            row["name"].casefold(),
        )
    )
    attention.sort(key=lambda row: row["name"].casefold())
    sections = [
        ("SHARED (all three clients)", shared),
        ("CLIENT-SPECIFIC", specific),
        ("NEEDS ATTENTION", attention),
    ]
    sections = [(title, rows) for title, rows in sections if rows]
    widths = [display_width(header) for header in headers]
    for _, rows in sections:
        for row in rows:
            widths = [
                max(width, display_width(cell))
                for width, cell in zip(widths, table_cells(row))
            ]
    rule = "─" * (sum(widths) + 2 * (len(widths) - 1))
    print("  ".join(pad(header, width) for header, width in zip(headers, widths)))
    print("  ".join("─" * width for width in widths))
    for title, rows in sections:
        print(f"\n{title}")
        print(rule)
        for row in rows:
            print("  ".join(pad(cell, width) for cell, width in zip(table_cells(row), widths)))
    summary = inventory["summary"]
    skills = summary["skills"]
    anomalies = summary["anomalies"]
    print(
        f"\n{skills} skill{'s' if skills != 1 else ''} · "
        f"{summary['three_client_healthy']} shared across all clients · "
        f"{anomalies} issue{'s' if anomalies != 1 else ''}"
    )
    if any(row.get("update_available") for row in inventory["skills"]):
        checked = inventory.get("update_checked_at", "an unknown time")
        print(f"↑ = update available (as of {checked}); run `osk outdated` to refresh")


def shell_join(*parts: Path | str) -> str:
    return " ".join(shlex.quote(str(part)) for part in parts)


def repair_for(
    row: dict[str, Any], client: str, status: dict[str, Any], cfg: dict[str, Path]
) -> str:
    path = Path(status["path"])
    raw_body = row.get("body")
    body = Path(raw_body) if raw_body is not None else None
    state = status["state"]
    if state == "unmanaged":
        return shell_join("osk", "adopt", path)
    if state in {"missing"}:
        if body is None:
            return "no shared body yet; adopt an existing copy with `osk adopt` first"
        if normalized(body) == normalized(path):
            return shell_join("osk", "adopt", path)
        return shell_join("ln", "-s", body, path)
    if state in {"real_directory", "real_file", "wrong_target", "orphan_link"}:
        if body is None or normalized(body) == normalized(path):
            # never emit a command whose source and target are the same path
            return shell_join("osk", "adopt", path)
        backup = backup_target(path, cfg)
        if not body.exists():
            return f"restore the body {shlex.quote(str(body))} first, then rebuild {shlex.quote(str(path))}"
        return (
            f"{shell_join('mkdir', '-p', backup.parent)} && "
            f"{shell_join('mv', path, backup)} && {shell_join('ln', '-s', body, path)}"
        )
    if state == "extra":
        backup = backup_target(path, cfg)
        return f"{shell_join('mkdir', '-p', backup.parent)} && {shell_join('mv', path, backup)}"
    if state == "plugin_missing":
        plugin_id = row.get("plugin_id", row["name"])
        return f"reinstall plugin {shlex.quote(str(plugin_id))} with Claude Code"
    return "no repair needed"


def diagnose(inventory: dict[str, Any], cfg: dict[str, Path]) -> dict[str, Any]:
    issues: list[dict[str, Any]] = []
    body_reported: set[str] = set()
    for row in inventory["skills"]:
        if row["declared"] and row.get("review") and row["body"] is not None:
            issues.append(
                {
                    "type": "scope_review",
                    "skill": row["name"],
                    "client": None,
                    "path": inventory["manifest"],
                    "message": str(row["review"]),
                    "suggested_command": (
                        f"{shell_join('vi', inventory['manifest'])} && osk sync"
                    ),
                }
            )
        if (
            row["declared"]
            and row["source"] != "plugin"
            and row["body"] is not None
            and not Path(row["body"]).exists()
        ):
            if row["name"] not in body_reported:
                issues.append(
                    {
                        "type": "body_missing",
                        "skill": row["name"],
                        "client": None,
                        "path": row["body"],
                        "message": "the body declared in the manifest does not exist",
                        "suggested_command": f"restore {shlex.quote(row['body'])} from version control or a backup",
                    }
                )
                body_reported.add(row["name"])
        unmanaged = [
            (client, row["clients"][client])
            for client in CLIENTS
            if row["clients"][client]["state"] == "unmanaged"
        ]
        if unmanaged:
            client, status = unmanaged[0]
            duplicate_clients = [item[0] for item in unmanaged[1:]]
            message = "not in the shared library yet"
            if duplicate_clients:
                names = ", ".join(duplicate_clients)
                message += f"; same-name copies in {names} will be merged and backed up"
            issue = {
                "type": "unmanaged",
                "skill": row["name"],
                "client": client,
                "path": status["path"],
                "message": message,
                "suggested_command": repair_for(row, client, status, cfg),
            }
            if duplicate_clients:
                issue["duplicate_clients"] = duplicate_clients
            issues.append(issue)
        for client in CLIENTS:
            status = row["clients"][client]
            state = status["state"]
            if state in {"healthy", "plugin", "not_applicable", "unmanaged"}:
                continue
            messages = {
                "missing": "manifest declares a symlink that is missing",
                "plugin_missing": "the Claude plugin body does not exist",
                "orphan_link": "broken symlink: the target body does not exist",
                "wrong_target": "symlink target does not match the manifest",
                "real_directory": "a real directory shadows the expected symlink",
                "real_file": "a real file shadows the expected symlink",
                "unmanaged": "not in the shared library yet",
                "extra": "item not declared in the manifest",
            }
            issues.append(
                {
                    "type": state,
                    "skill": row["name"],
                    "client": client,
                    "path": status["path"],
                    "message": messages[state],
                    "suggested_command": repair_for(row, client, status, cfg),
                }
            )
    counts = Counter(issue["type"] for issue in issues)
    return {
        "manifest": inventory["manifest"],
        "issues": issues,
        "summary": {"issues": len(issues), "by_type": dict(sorted(counts.items()))},
    }


def render_doctor(report: dict[str, Any]) -> None:
    if not report["issues"]:
        print("No issues found.")
        return
    for index, issue in enumerate(report["issues"], 1):
        endpoint = f" [{issue['client']}]" if issue["client"] else ""
        print(f"{index}. {issue['skill']}{endpoint}: {issue['message']}")
        print(f"   path: {issue['path']}")
        print(f"   fix: {issue['suggested_command']}")
    print(f"\nFound {report['summary']['issues']} issue(s); doctor made no changes.")


def parse_scope(value: str, origin: str) -> Any:
    if value == "shared":
        return "shared"
    requested = [item.strip() for item in value.split(",") if item.strip()]
    invalid = [item for item in requested if item not in CLIENTS]
    if invalid:
        raise OneskillError(f"--scope contains unknown client name(s): {', '.join(invalid)}")
    if origin not in requested:
        raise OneskillError(f"--scope must include the origin client {origin}")
    return [client for client in CLIENTS if client in requested]


def unique_backup(path: Path) -> Path:
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    candidate = Path(f"{path}.oneskill-backup-{stamp}")
    number = 2
    while path_exists(candidate):
        candidate = Path(f"{path}.oneskill-backup-{stamp}-{number}")
        number += 1
    return candidate


def prune_backups(path: Path, keep: int) -> list[Path]:
    """Drop old `<name>.oneskill-backup-*` siblings, newest `keep` retained.

    Called only after an update has succeeded. The in-flight backup is what
    `rollback_remote_change` restores from, so it is always created; this just
    stops the copies piling up afterwards. Default is to keep none: a remote
    skill records source_url and ref, so any older version can be refetched
    from upstream, while a 118MB skill would otherwise double on every update.
    Timestamps are fixed-width, so lexical order is chronological order.
    """
    if keep < 0:
        raise OneskillError("--keep-backups must be zero or greater")
    prefix = f"{path.name}.oneskill-backup-"
    existing = sorted(
        (item for item in path.parent.glob(f"{prefix}*") if item.name != path.name),
        key=lambda item: item.name,
    )
    removed: list[Path] = []
    for item in existing[: max(len(existing) - keep, 0)]:
        try:
            if item.is_symlink() or item.is_file():
                item.unlink()
            else:
                shutil.rmtree(item)
        except OSError:
            # a backup we cannot remove is not a reason to fail the update
            continue
        removed.append(item)
    return removed


def backup_target(path: Path, cfg: dict[str, Path]) -> Path:
    """Choose a backup path without leaving loadable copies in client skill directories."""
    for client in CLIENTS:
        if not within(path.parent, cfg[client]):
            continue
        external_root = cfg["home"] / ".oneskill" / "backups"
        if any(within(external_root, cfg[item]) for item in CLIENTS):
            raise OneskillError(
                f"external backup directory overlaps a client skills directory: {external_root}"
            )
        backup_root = external_root / client
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        candidate = backup_root / f"{path.name}.oneskill-backup-{stamp}"
        number = 2
        while path_exists(candidate):
            candidate = backup_root / f"{path.name}.oneskill-backup-{stamp}-{number}"
            number += 1
        return candidate
    return unique_backup(path)


def confirm(description: str, assume_yes: bool, dry_run: bool = False) -> bool:
    print(f"About to: {description}")
    if dry_run:
        return True
    if assume_yes:
        print("  --yes: confirmed")
        return True
    try:
        answer = input("Proceed? [y/N] ").strip().lower()
    except EOFError:
        answer = ""
    return answer in {"y", "yes"}


def rollback_adopt(
    created: list[Path], backups: list[tuple[Path, Path]], moved: tuple[Path, Path] | None
) -> None:
    for path in reversed(created):
        if path.is_symlink():
            path.unlink()
    for original, backup in reversed(backups):
        if path_exists(original):
            if original.is_symlink():
                original.unlink()
            else:
                continue
        if path_exists(backup):
            os.replace(backup, original)
    if moved:
        source, target = moved
        if path_exists(target) and not path_exists(source):
            shutil.move(str(target), str(source))


def remote_entry(name: str, description: str, target: Path, resolved: dict[str, Any]) -> dict[str, Any]:
    return {
        "name": name,
        "source": "remote",
        "body": str(target),
        "scope": "shared",
        "description": description,
        "provenance": {
            "source_url": resolved["source_url"],
            "ref": resolved["ref"],
            "installed_at": installed_at_now(),
        },
    }


def remote_body_for_entry(entry: dict[str, Any], cfg: dict[str, Path]) -> Path:
    expected = cfg["library"] / "remote" / entry["name"]
    raw_body = entry.get("body")
    if not isinstance(raw_body, str) or normalized(Path(raw_body)) != normalized(expected):
        raise OneskillError(
            f"remote skill {entry['name']} has an unsafe or unexpected body path: {raw_body!r}"
        )
    return expected


def rollback_remote_change(
    target: Path,
    body_backup: Path | None,
    target_replaced: bool,
    created_links: list[Path],
    path_backups: list[tuple[Path, Path]],
    replaced_links: list[tuple[Path, str]],
) -> None:
    for path in reversed(created_links):
        if path.is_symlink():
            path.unlink()
    for path, raw_target in reversed(replaced_links):
        if path.is_symlink():
            path.unlink()
        if not path_exists(path):
            path.symlink_to(raw_target, target_is_directory=True)
    for original, backup in reversed(path_backups):
        if original.is_symlink():
            original.unlink()
        if not path_exists(original) and path_exists(backup):
            os.replace(backup, original)
    if target_replaced and path_exists(target):
        failed_backup = unique_backup(target)
        os.replace(target, failed_backup)
    if body_backup is not None and path_exists(body_backup) and not path_exists(target):
        os.replace(body_backup, target)


def command_install(args: argparse.Namespace, cfg: dict[str, Path]) -> int:
    manifest = read_manifest(cfg["manifest"], allow_missing=True)
    with materialize_skill_source(args.source) as resolved:
        source_dir = Path(resolved["directory"])
        metadata = read_skill_metadata(source_dir)
        name, description = metadata["name"], metadata["description"]
        validate_remote_skill_name(name)
        target = cfg["library"] / "remote" / name
        if within(source_dir, target) or within(target, source_dir):
            raise OneskillError("source directory and installation target must not contain one another")

        print(f"Source: {resolved['source_url']}")
        print(f"Name: {name}")
        print(f"Description: {description}")
        if args.review:
            skill_text = (source_dir / "SKILL.md").read_text(encoding="utf-8")
            print(f"\n===== BEGIN SKILL.md: {name} =====")
            print(skill_text, end="" if skill_text.endswith("\n") else "\n")
            print(f"===== END SKILL.md: {name} =====\n")

        existing_entry = next((item for item in manifest["skills"] if item["name"] == name), None)
        body_backup = unique_backup(target) if path_exists(target) else None
        actions: list[dict[str, Any]] = []
        for client in CLIENTS:
            destination = cfg[client] / name
            if destination.is_symlink() and link_target(destination) == normalized(target):
                continue
            if destination.is_symlink():
                actions.append(
                    {"kind": "replace_link", "path": destination, "raw_target": os.readlink(destination)}
                )
            elif path_exists(destination):
                actions.append(
                    {"kind": "replace_real", "path": destination, "backup": backup_target(destination, cfg)}
                )
            else:
                actions.append({"kind": "create", "path": destination})

        confirmations = [f"install {name} into {target} and link it into all clients"]
        if body_backup is not None:
            confirmations.append(f"move existing body {target} -> {body_backup}")
        if existing_entry is not None:
            confirmations.append(f"replace existing manifest entry for {name}")
        for action in actions:
            if action["kind"] == "replace_real":
                confirmations.append(
                    f"move conflicting item {action['path']} -> {action['backup']}"
                )
            elif action["kind"] == "replace_link":
                confirmations.append(f"replace conflicting symlink {action['path']} -> {target}")
        for description_text in confirmations:
            if not confirm(description_text, args.yes, args.dry_run):
                print("Declined; no changes were made.")
                return 1
        for action in actions:
            if action["kind"] == "create":
                print(f"About to: create symlink {action['path']} -> {target}")
        print(f"About to: update manifest {cfg['manifest']}")
        if args.dry_run:
            print("dry-run complete: no changes made.")
            return 0

        created_links: list[Path] = []
        path_backups: list[tuple[Path, Path]] = []
        replaced_links: list[tuple[Path, str]] = []
        body_moved = False
        target_replaced = body_backup is None
        try:
            target.parent.mkdir(parents=True, exist_ok=True)
            if body_backup is not None:
                os.replace(target, body_backup)
                body_moved = True
                target_replaced = True
            shutil.copytree(source_dir, target, symlinks=True)
            for action in actions:
                destination = action["path"]
                destination.parent.mkdir(parents=True, exist_ok=True)
                if action["kind"] == "replace_real":
                    action["backup"].parent.mkdir(parents=True, exist_ok=True)
                    os.replace(destination, action["backup"])
                    path_backups.append((destination, action["backup"]))
                elif action["kind"] == "replace_link":
                    destination.unlink()
                    replaced_links.append((destination, action["raw_target"]))
                destination.symlink_to(target, target_is_directory=True)
                created_links.append(destination)
            replacement = remote_entry(name, description, target, resolved)
            if existing_entry is None:
                manifest["skills"].append(replacement)
            else:
                manifest["skills"][manifest["skills"].index(existing_entry)] = replacement
            write_manifest(cfg["manifest"], manifest)
        except Exception as exc:
            rollback_remote_change(
                target,
                body_backup if body_moved else None,
                target_replaced,
                created_links,
                path_backups,
                replaced_links,
            )
            raise OneskillError(f"installation failed; rolled back as far as possible: {exc}") from exc
    print(f"installed: {name}")
    return 0


def render_change_summary(name: str, changes: dict[str, list[str]]) -> None:
    print(f"Changes for {name}:")
    for kind in ("added", "removed", "modified"):
        for path in changes[kind]:
            print(f"  {kind}: {path}")


def command_update(args: argparse.Namespace, cfg: dict[str, Path]) -> int:
    manifest = read_manifest(cfg["manifest"])
    remotes = [item for item in manifest["skills"] if item["source"] == "remote"]
    if args.name:
        remotes = [item for item in remotes if item["name"] == args.name]
        if not remotes:
            raise OneskillError(f"remote skill not found: {args.name}")
    if not remotes:
        print("No remote skills to update.")
        return 0

    for entry in remotes:
        name = entry["name"]
        provenance = entry.get("provenance")
        if not isinstance(provenance, dict) or not isinstance(provenance.get("source_url"), str):
            raise OneskillError(f"remote skill {name} has no source_url provenance")
        target = remote_body_for_entry(entry, cfg)
        if not target.is_dir() or target.is_symlink():
            raise OneskillError(f"remote skill body is missing or not a real directory: {target}")
        with materialize_skill_source(provenance["source_url"]) as resolved:
            source_dir = Path(resolved["directory"])
            metadata = read_skill_metadata(source_dir)
            validate_remote_skill_name(metadata["name"])
            if metadata["name"] != name:
                raise OneskillError(
                    f"updated source declares skill name {metadata['name']!r}, expected {name!r}"
                )
            changes = compare_skill_trees(target, source_dir)
            if not any(changes.values()):
                print(f"{name}: already up to date")
                continue
            render_change_summary(name, changes)
            backup = unique_backup(target)
            if not confirm(
                f"move current body {target} -> {backup}, install the update, and refresh the manifest",
                args.yes,
                args.dry_run,
            ):
                print(f"Declined; {name} was not changed.")
                continue
            if args.dry_run:
                print(f"dry-run complete for {name}: no changes made.")
                continue
            body_moved = False
            target_replaced = False
            try:
                os.replace(target, backup)
                body_moved = True
                target_replaced = True
                shutil.copytree(source_dir, target, symlinks=True)
                entry["description"] = metadata["description"]
                entry["provenance"] = {
                    "source_url": resolved["source_url"],
                    "ref": resolved["ref"],
                    "installed_at": installed_at_now(),
                }
                write_manifest(cfg["manifest"], manifest)
            except Exception as exc:
                rollback_remote_change(
                    target,
                    backup if body_moved else None,
                    target_replaced,
                    [],
                    [],
                    [],
                )
                raise OneskillError(f"update of {name} failed; rolled back as far as possible: {exc}") from exc
            print(f"updated: {name}")
            for stale in prune_backups(target, args.keep_backups):
                print(f"  removed old backup: {stale}")
    return 0


def command_uninstall(args: argparse.Namespace, cfg: dict[str, Path]) -> int:
    manifest = read_manifest(cfg["manifest"])
    entry = next((item for item in manifest["skills"] if item["name"] == args.name), None)
    if entry is None or entry["source"] != "remote":
        raise OneskillError(f"remote skill not found: {args.name}")
    target = remote_body_for_entry(entry, cfg)
    if not target.is_dir() or target.is_symlink():
        raise OneskillError(f"remote skill body is missing or not a real directory: {target}")
    links: list[tuple[Path, str]] = []
    for client in CLIENTS:
        path = cfg[client] / args.name
        if path.is_symlink() and link_target(path) == normalized(target):
            links.append((path, os.readlink(path)))
    backup = unique_backup(target)
    confirmations = [f"unlink {path} (the skill body remains intact)" for path, _ in links]
    confirmations.extend(
        [
            f"move skill body {target} -> {backup}",
            f"remove {args.name} from manifest {cfg['manifest']}",
        ]
    )
    for description in confirmations:
        if not confirm(description, args.yes, args.dry_run):
            print("Declined; no changes were made.")
            return 1
    if args.dry_run:
        print("dry-run complete: no changes made.")
        return 0

    unlinked: list[tuple[Path, str]] = []
    body_moved = False
    try:
        for path, raw_target in links:
            path.unlink()
            unlinked.append((path, raw_target))
        os.replace(target, backup)
        body_moved = True
        manifest["skills"].remove(entry)
        write_manifest(cfg["manifest"], manifest)
    except Exception as exc:
        if body_moved and path_exists(backup) and not path_exists(target):
            os.replace(backup, target)
        for path, raw_target in unlinked:
            if not path_exists(path):
                path.parent.mkdir(parents=True, exist_ok=True)
                path.symlink_to(raw_target, target_is_directory=True)
        raise OneskillError(f"uninstall failed; rolled back as far as possible: {exc}") from exc
    print(f"uninstalled: {args.name}; body preserved at {backup}")
    return 0


def command_init(args: argparse.Namespace) -> int:
    home = Path(os.environ.get("ONESKILL_HOME", str(Path.home()))).expanduser().absolute()
    config_path = config_file_path(home)
    agents_library = home.joinpath(*AGENTS_LIBRARY_PARTS)
    agents_available = agents_library.is_dir()
    default_library = agents_library if agents_available else home.joinpath(*DEFAULT_LIBRARY_PARTS)
    default_manifest = home.joinpath(*CONFIG_DIR_PARTS, "skills.json")

    if config_path.is_file():
        print(f"config file already exists: {config_path}")
        try:
            existing = json.loads(config_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            existing = None
        if isinstance(existing, dict):
            print(json.dumps(existing, ensure_ascii=False, indent=2))
        else:
            print("(existing content is not a valid JSON object)")
        overwrite = args.yes
        if not overwrite:
            try:
                answer = input("Overwrite? [y/N] ").strip().lower()
            except EOFError:
                answer = ""
            overwrite = answer in {"y", "yes"}
        if not overwrite:
            print("Declined; existing configuration left unchanged.")
            return 1

    library = default_library
    if not args.yes:
        if agents_available:
            print(f"found community-shared skills directory: {agents_library}")
            print("  (~/.agents/skills is the community convention shared by AI coding tools)")
            print(f"  press enter to use it, or type another path, e.g. {home.joinpath(*DEFAULT_LIBRARY_PARTS)}")
        try:
            answer = input(f"Skill library directory [{default_library}]: ").strip()
        except EOFError:
            answer = ""
        if answer:
            library = Path(answer).expanduser().absolute()

    try:
        existed = library.is_dir()
        library.mkdir(parents=True, exist_ok=True)
        config_path.parent.mkdir(parents=True, exist_ok=True)
        payload = {"library": str(library), "manifest": str(default_manifest)}
        config_path.write_text(
            json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
        )
    except OSError as exc:
        raise OneskillError(f"init failed: {exc}") from exc
    if existed:
        print(f"library directory already exists: {library}")
    else:
        print(f"created library directory: {library}")
    print(f"wrote config: {config_path}")
    print("next step: run `osk scan --write` to generate the manifest")
    return 0


def command_adopt_one(args: argparse.Namespace, cfg: dict[str, Path]) -> int:
    source_path = Path(args.path).expanduser().absolute()
    if source_path.is_symlink() or not source_path.is_dir():
        raise OneskillError("adopt only accepts existing real directories inside a client skills directory")
    origin = next(
        (client for client in CLIENTS if source_path.parent == cfg[client].absolute()), None
    )
    if origin is None:
        expected = ", ".join(str(cfg[client]) for client in CLIENTS)
        raise OneskillError(f"path must sit directly inside one of the client skills directories: {expected}")
    name = source_path.name
    manifest = read_manifest(cfg["manifest"], allow_missing=True)
    existing = next((item for item in manifest["skills"] if item["name"] == name), None)
    if existing is not None and existing.get("body") is not None:
        raise OneskillError(f"manifest already declares {name}; use sync to reconcile")
    scope = parse_scope(args.scope, origin)
    selected = scope_clients(scope)
    target = (
        cfg["library"] / "vendor" / name
        if args.vendor
        else cfg["library"] / origin / "skills" / name
    )
    if path_exists(target):
        raise OneskillError(f"target body already exists; refusing to overwrite: {target}")

    replacements: list[tuple[Path, Path]] = []
    for client in selected:
        destination = cfg[client] / name
        if destination == source_path or not path_exists(destination):
            continue
        if destination.is_symlink() and link_target(destination) == normalized(target):
            continue
        replacements.append((destination, backup_target(destination, cfg)))

    confirmations = [
        f"move body {source_path} -> {target}",
        f"create symlink {source_path} -> {target}",
    ]
    for path, backup in replacements:
        confirmations.append(f"move conflicting item {path} -> {backup}")
        confirmations.append(f"create symlink in the vacated spot {path} -> {target}")
    print(f"Adoption plan: {name} ({origin} -> {scope_label(scope)}, source {'vendor' if args.vendor else 'self'})")
    for description in confirmations:
        if not confirm(description, args.yes, args.dry_run):
            print("Declined; no changes were made.")
            return 1
    for client in selected:
        destination = cfg[client] / name
        if destination == source_path or path_exists(destination):
            continue
        print(f"About to: create symlink {destination} -> {target}")
    print(f"About to: update manifest {cfg['manifest']}")
    if args.dry_run:
        print("dry-run complete: no changes made.")
        return 0

    created: list[Path] = []
    backups_done: list[tuple[Path, Path]] = []
    moved: tuple[Path, Path] | None = None
    try:
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(source_path), str(target))
        moved = (source_path, target)
        source_path.symlink_to(target, target_is_directory=True)
        created.append(source_path)
        for destination, backup in replacements:
            destination.parent.mkdir(parents=True, exist_ok=True)
            backup.parent.mkdir(parents=True, exist_ok=True)
            os.replace(destination, backup)
            backups_done.append((destination, backup))
            destination.symlink_to(target, target_is_directory=True)
            created.append(destination)
        for client in selected:
            destination = cfg[client] / name
            if path_exists(destination):
                continue
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.symlink_to(target, target_is_directory=True)
            created.append(destination)
        if existing is not None:
            # scan wrote this entry with a null body (unmanaged); complete it
            existing.pop("review", None)
            existing.update(
                source="vendor" if args.vendor else "self",
                body=str(target),
                scope=scope,
            )
        else:
            entry: dict[str, Any] = {
                "name": name,
                "source": "vendor" if args.vendor else "self",
                "body": str(target),
                "scope": scope,
            }
            manifest["skills"].append(entry)
        write_manifest(cfg["manifest"], manifest)
    except Exception as exc:
        rollback_adopt(created, backups_done, moved)
        raise OneskillError(f"adoption failed; rolled back as far as possible: {exc}") from exc
    print(f"adopted: {name}")
    return 0


def unmanaged_adoption_sources(cfg: dict[str, Path]) -> list[tuple[str, Path]]:
    manifest = read_manifest(cfg["manifest"], allow_missing=True)
    inventory = build_inventory(cfg, manifest)
    sources: list[tuple[str, Path]] = []
    for row in inventory["skills"]:
        for client in CLIENTS:
            status = row["clients"][client]
            if status["state"] == "unmanaged":
                sources.append((row["name"], Path(status["path"])))
                break
    return sources


def command_adopt(args: argparse.Namespace, cfg: dict[str, Path]) -> int:
    if not args.adopt_all:
        return command_adopt_one(args, cfg)

    sources = unmanaged_adoption_sources(cfg)
    if not sources:
        print("No unmanaged skills to adopt.")
        return 0
    total = len(sources)
    for index, (name, source) in enumerate(sources, 1):
        print(f"Adopting {index}/{total}: {name} from {source}")
        item_args = argparse.Namespace(
            path=str(source),
            vendor=args.vendor,
            scope=args.scope,
            dry_run=args.dry_run,
            yes=args.yes,
        )
        result = command_adopt_one(item_args, cfg)
        if result != 0:
            print(f"Stopped before adopting the remaining skills; {name} was not adopted.", file=sys.stderr)
            return result
    if args.dry_run:
        print(f"adopt --all dry-run complete: {total} skill(s) planned, none applied.")
    else:
        print(f"adopt --all complete: {total} skill(s) adopted.")
    return 0


def command_sync(args: argparse.Namespace, cfg: dict[str, Path]) -> int:
    manifest = read_manifest(cfg["manifest"])
    inventory = build_inventory(cfg, manifest)
    actions: list[dict[str, Any]] = []
    unresolved: list[str] = []
    for row in inventory["skills"]:
        if not row["declared"]:
            actual_clients = [
                client for client in CLIENTS if row["clients"][client]["state"] == "extra"
            ]
            unresolved.append(f"{row['name']}: extra item(s) outside the manifest ({','.join(actual_clients)})")
            continue
        if row["source"] == "plugin":
            if row["clients"]["claude"]["state"] == "plugin_missing":
                unresolved.append(f"{row['name']}: plugin body missing; reinstall via the Claude plugin system")
            continue
        if row["body"] is None:
            holders = [
                client for client in CLIENTS if row["clients"][client]["state"] == "unmanaged"
            ]
            hint = f"adopt {row['clients'][holders[0]]['path']}" if holders else "adopt an existing copy"
            unresolved.append(f"{row['name']}: not in the shared library yet; run `osk {hint}` first")
            continue
        body = Path(row["body"])
        for client in CLIENTS:
            if row["clients"][client]["state"] == "extra":
                unresolved.append(
                    f"{row['name']}: {client} has an out-of-scope extra item {row['clients'][client]['path']}"
                )
            elif row["clients"][client]["state"] == "unmanaged":
                unresolved.append(
                    f"{row['name']}: {client} has an unmanaged real directory {row['clients'][client]['path']}; run `osk adopt`"
                )
        if not body.exists():
            unresolved.append(f"{row['name']}: body does not exist {body}")
            continue
        for client in scope_clients(row["scope"]):
            status = row["clients"][client]
            state = status["state"]
            destination = Path(status["path"])
            if state == "healthy":
                continue
            if state in {"missing", "real_directory", "real_file", "wrong_target", "orphan_link"}:
                if normalized(body) == normalized(destination):
                    # never create a symlink whose target is its own path
                    unresolved.append(
                        f"{row['name']}: {client}: refusing self-referential link at {destination}; run `osk adopt`"
                    )
                    continue
            if state == "missing":
                actions.append({"kind": "create", "path": destination, "body": body})
            elif state in {"real_directory", "real_file", "wrong_target", "orphan_link"}:
                actions.append(
                    {
                        "kind": "replace",
                        "path": destination,
                        "body": body,
                        "backup": backup_target(destination, cfg),
                        "state": state,
                    }
                )

    for action in actions:
        if action["kind"] == "create":
            print(f"About to: create symlink {action['path']} -> {action['body']}")
        else:
            description = (
                f"move drifted item {action['path']} -> {action['backup']}, "
                f"then create symlink -> {action['body']}"
            )
            if not confirm(description, args.yes, args.dry_run):
                print("Declined this item; continuing with the rest.")
                action["skip"] = True
    if args.dry_run:
        planned = sum(not action.get("skip") for action in actions)
        print(f"dry-run complete: {planned} change(s) planned, none applied.")
        for item in unresolved:
            print(f"drift: {item}")
        return 0

    changed = 0
    for action in actions:
        if action.get("skip"):
            unresolved.append(f"{action['path']}: user declined the replacement")
            continue
        destination = action["path"]
        try:
            destination.parent.mkdir(parents=True, exist_ok=True)
            if action["kind"] == "replace":
                action["backup"].parent.mkdir(parents=True, exist_ok=True)
                os.replace(destination, action["backup"])
            destination.symlink_to(action["body"], target_is_directory=True)
            changed += 1
        except OSError as exc:
            unresolved.append(f"{destination}: failed: {exc}")
            if action["kind"] == "replace" and path_exists(action["backup"]):
                if destination.is_symlink():
                    destination.unlink()
                if not path_exists(destination):
                    os.replace(action["backup"], destination)
    if changed == 0:
        print("sync complete: no changes.")
    else:
        print(f"sync complete: {changed} change{'s' if changed != 1 else ''} applied.")
    for item in unresolved:
        print(f"drift: {item}")
    return 1 if unresolved else 0


def github_latest_ref(owner: str, repo: str, subdir: str | None, branch: str | None) -> str:
    query = {"per_page": "1"}
    if branch:
        query["sha"] = branch
    if subdir:
        query["path"] = subdir
    url = f"https://api.github.com/repos/{owner}/{repo}/commits?{urllib.parse.urlencode(query)}"
    data = http_get_json(url)
    if (
        not isinstance(data, list)
        or not data
        or not isinstance(data[0], dict)
        or not isinstance(data[0].get("sha"), str)
        or not data[0]["sha"]
    ):
        raise OneskillError(f"unexpected GitHub commits response for {owner}/{repo}")
    return data[0]["sha"]


def command_outdated(args: argparse.Namespace, cfg: dict[str, Path]) -> int:
    manifest = read_manifest(cfg["manifest"])
    remotes = [item for item in manifest["skills"] if item["source"] == "remote"]
    if args.name:
        remotes = [item for item in remotes if item["name"] == args.name]
        if not remotes:
            raise OneskillError(f"remote skill not found: {args.name}")
    if not remotes:
        print("No remote skills to check.")
        return 0

    checked_at = installed_at_now()
    results: list[dict[str, Any]] = []
    for entry in remotes:
        name = entry["name"]
        provenance = entry.get("provenance")
        if not isinstance(provenance, dict) or not isinstance(provenance.get("source_url"), str):
            raise OneskillError(f"remote skill {name} has no source_url provenance")
        source_url = provenance["source_url"]
        if not source_url.startswith("gh:"):
            print(f"{name}: skipped (not a gh: source)")
            continue
        pinned = provenance.get("ref", "")
        owner, repo, subdir, branch = parse_github_source(source_url)
        latest = github_latest_ref(owner, repo, subdir, branch)
        results.append(
            {
                "name": name,
                "pinned_ref": pinned,
                "latest_ref": latest,
                "update_available": bool(pinned) and latest[: len(pinned)] != pinned,
            }
        )
    if not results:
        print("No gh:-sourced remote skills to check.")
        return 0

    cache_payload = {
        "checked_at": checked_at,
        "skills": {
            item["name"]: {
                "pinned_ref": item["pinned_ref"],
                "latest_ref": item["latest_ref"],
                "update_available": item["update_available"],
                "checked_at": checked_at,
            }
            for item in results
        },
    }
    cache_path = update_cache_path(cfg)
    try:
        cache_path.parent.mkdir(parents=True, exist_ok=True)
        cache_path.write_text(
            json.dumps(cache_payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
        )
    except OSError as exc:
        raise OneskillError(f"cannot write update cache {cache_path}: {exc}") from exc

    updates = sum(item["update_available"] for item in results)
    if args.json:
        json.dump(
            {"checked_at": checked_at, "skills": results, "updates_available": updates},
            sys.stdout,
            ensure_ascii=False,
            indent=2,
        )
        print()
        return 0

    headers = ("skill", "pinned", "latest", "status")
    rows = [
        (
            item["name"],
            item["pinned_ref"][:12],
            item["latest_ref"][:12],
            "update available" if item["update_available"] else "up to date",
        )
        for item in results
    ]
    widths = [display_width(header) for header in headers]
    for row in rows:
        widths = [max(width, display_width(cell)) for width, cell in zip(widths, row)]
    print("  ".join(pad(header, width) for header, width in zip(headers, widths)))
    print("  ".join("─" * width for width in widths))
    for row in rows:
        print("  ".join(pad(cell, width) for cell, width in zip(row, widths)))
    total = len(results)
    print(
        f"\n{total} remote skill{'s' if total != 1 else ''} · "
        f"{updates} update{'s' if updates != 1 else ''} available"
    )
    if updates:
        print("run `osk update <name>` to apply an update")
    return 0


def format_installs(count: int) -> str:
    if count >= 1_000_000:
        return f"{count / 1_000_000:.1f}M"
    if count >= 1_000:
        return f"{count / 1_000:.1f}k"
    return str(count)


def command_search(args: argparse.Namespace) -> int:
    query = args.query.strip()
    if not query:
        raise OneskillError("search query must not be empty")
    if args.limit < 1:
        raise OneskillError("--limit must be a positive integer")
    url = "https://skills.sh/api/search?q=" + urllib.parse.quote(query)
    data = http_get_json(url)
    if not isinstance(data, dict) or not isinstance(data.get("skills"), list):
        raise OneskillError("unexpected response from skills.sh: missing the skills array")
    results: list[dict[str, Any]] = []
    skipped = 0
    for item in data["skills"][: args.limit]:
        if not isinstance(item, dict):
            skipped += 1
            continue
        name, source, skill_id = item.get("name"), item.get("source"), item.get("skillId")
        installs = item.get("installs")
        if (
            not all(isinstance(value, str) and value for value in (name, source, skill_id))
            or not isinstance(installs, int)
            or isinstance(installs, bool)
        ):
            skipped += 1
            continue
        results.append(
            {
                "name": name,
                "source": source,
                "installs": installs,
                "install": f"gh:{source}/{skill_id}@main",
            }
        )
    if args.json:
        json.dump(
            {"query": query, "results": results, "skipped": skipped},
            sys.stdout,
            ensure_ascii=False,
            indent=2,
        )
        print()
        return 0
    if not results:
        raise OneskillError("skills.sh returned no usable entries")
    headers = ("name", "source", "installs", "install source")
    rows = [
        (item["name"], item["source"], format_installs(item["installs"]), item["install"])
        for item in results
    ]
    widths = [display_width(header) for header in headers]
    for row in rows:
        widths = [max(width, display_width(cell)) for width, cell in zip(widths, row)]
    print("  ".join(pad(header, width) for header, width in zip(headers, widths)))
    print("  ".join("─" * width for width in widths))
    for row in rows:
        print("  ".join(pad(cell, width) for cell, width in zip(row, widths)))
    if skipped:
        entry_word = "entry" if skipped == 1 else "entries"
        print(f"\nskipped {skipped} malformed {entry_word} from skills.sh")
    print(
        "\nnote: skills.sh ids are not guaranteed to match the real subdirectory inside the"
        " repository; confirm with `osk install <source> --dry-run --review` and adjust the"
        " subdirectory if needed"
    )
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="osk", description="Audit and reconcile skills shared across Claude, Codex and Kimi")
    parser.add_argument("--version", "-V", action="version", version=f"oneskill {__version__}")
    subparsers = parser.add_subparsers(dest="command", required=True)

    init_parser = subparsers.add_parser("init", help="interactive first-time setup; writes ~/.config/oneskill/config.json")
    init_parser.add_argument("--yes", action="store_true", help="accept all defaults without prompting")

    list_parser = subparsers.add_parser("list", help="show the skill coverage matrix")
    list_parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")

    doctor_parser = subparsers.add_parser("doctor", help="read-only diagnosis of drift")
    doctor_parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")

    scan_parser = subparsers.add_parser("scan", help="scan the environment and draft a manifest")
    scan_parser.add_argument("--write", action="store_true", help="write the manifest; otherwise print to stdout")

    adopt_parser = subparsers.add_parser("adopt", help="adopt real in-client directories into the shared library")
    adopt_source = adopt_parser.add_mutually_exclusive_group(required=True)
    adopt_source.add_argument("path", nargs="?", help="real skill directory to adopt")
    adopt_source.add_argument(
        "--all",
        dest="adopt_all",
        action="store_true",
        help="adopt every unmanaged skill, merging same-name client copies once",
    )
    adopt_parser.add_argument("--vendor", action="store_true", help="place under the library's vendor directory")
    adopt_parser.add_argument(
        "--scope",
        default="shared",
        help="shared (default) or comma-separated clients, e.g. codex,kimi",
    )
    adopt_parser.add_argument("--dry-run", action="store_true", help="print the plan only")
    adopt_parser.add_argument("--yes", action="store_true", help="auto-confirm (mainly for tests/automation)")

    sync_parser = subparsers.add_parser("sync", help="idempotently create links and reconcile against the manifest")
    sync_parser.add_argument("--dry-run", action="store_true", help="print the plan only")
    sync_parser.add_argument("--yes", action="store_true", help="auto-confirm replacement of drifted items")

    install_parser = subparsers.add_parser(
        "install", help="install a skill directory or gh:owner/repo[/subdir][@ref] source"
    )
    install_parser.add_argument("source", help="local skill directory or gh: GitHub source")
    install_parser.add_argument(
        "--review", action="store_true", help="print the complete SKILL.md before confirmation"
    )
    install_parser.add_argument("--dry-run", action="store_true", help="print the plan only")
    install_parser.add_argument("--yes", action="store_true", help="auto-confirm all actions")

    update_parser = subparsers.add_parser(
        "update", help="update one remote skill, or every remote skill when name is omitted"
    )
    update_parser.add_argument("name", nargs="?", help="remote skill name")
    update_parser.add_argument("--dry-run", action="store_true", help="print changes only")
    update_parser.add_argument("--yes", action="store_true", help="auto-confirm all updates")
    update_parser.add_argument(
        "--keep-backups",
        type=int,
        default=0,
        metavar="N",
        help="how many `.oneskill-backup-*` copies of each updated skill to keep after a successful "
        "update (default 0: keep none). A remote skill records its source_url and ref, so any older "
        "version can be fetched again from upstream; the backup is only the rollback path used while "
        "the update is in flight and is always taken regardless of this setting.",
    )

    uninstall_parser = subparsers.add_parser("uninstall", help="safely uninstall a remote skill")
    uninstall_parser.add_argument("name", help="remote skill name")
    uninstall_parser.add_argument("--dry-run", action="store_true", help="print the plan only")
    uninstall_parser.add_argument("--yes", action="store_true", help="auto-confirm all actions")

    outdated_parser = subparsers.add_parser(
        "outdated", help="check remote skills for updates via the GitHub API (read-only, no downloads)"
    )
    outdated_parser.add_argument("name", nargs="?", help="remote skill name")
    outdated_parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")

    search_parser = subparsers.add_parser("search", help="search the skills.sh public registry")
    search_parser.add_argument("query", help="search keywords")
    search_parser.add_argument(
        "--limit", type=int, default=20, help="maximum results to show (default: 20)"
    )
    search_parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if args.command == "init":
            return command_init(args)
        cfg = config()
        if args.command in {"list", "doctor", "scan", "sync", "install", "update", "uninstall"}:
            require_library(cfg)
        if args.command == "scan":
            draft = scan_environment(cfg)
            if args.write:
                write_manifest(cfg["manifest"], draft)
                print(f"wrote manifest draft: {cfg['manifest']} ({len(draft['skills'])} entries)")
            else:
                json.dump(draft, sys.stdout, ensure_ascii=False, indent=2)
                print()
            return 0
        if args.command == "list":
            inventory = build_inventory(cfg, read_manifest(cfg["manifest"]))
            apply_update_cache(inventory, read_update_cache(cfg))
            if args.json:
                json.dump(inventory, sys.stdout, ensure_ascii=False, indent=2)
                print()
            else:
                render_table(inventory)
            return 0
        if args.command == "doctor":
            report = diagnose(build_inventory(cfg, read_manifest(cfg["manifest"])), cfg)
            if args.json:
                json.dump(report, sys.stdout, ensure_ascii=False, indent=2)
                print()
            else:
                render_doctor(report)
            return 1 if report["issues"] else 0
        if args.command == "adopt":
            return command_adopt(args, cfg)
        if args.command == "sync":
            return command_sync(args, cfg)
        if args.command == "install":
            return command_install(args, cfg)
        if args.command == "update":
            return command_update(args, cfg)
        if args.command == "uninstall":
            return command_uninstall(args, cfg)
        if args.command == "outdated":
            return command_outdated(args, cfg)
        if args.command == "search":
            return command_search(args)
        parser.error("unknown command")
    except OneskillError as exc:
        if getattr(args, "json", False):
            json.dump({"error": str(exc)}, sys.stdout, ensure_ascii=False)
            print()
        else:
            print(f"error: {exc}", file=sys.stderr)
        return 2
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
